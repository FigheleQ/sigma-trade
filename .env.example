# ============================================================
# Sigma Trade — environment variables (copy to .env.local)
# ============================================================

# --- Supabase (Auth + Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Market data ---
# Finnhub: quotes, news, analyst recommendations. CSV pool supported:
# FINNHUB_API_KEYS=key1,key2   (round-robin, next key on 429)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# --- Gemini (Coach + News Analyzer) ---
# KEY FOR THE FREE TIER: use a CSV pool of keys from DIFFERENT Google projects.
# Free-tier limits (RPM / RPD) are applied per PROJECT and per MODEL, not per key,
# so keys from one project share one quota. The shared client (src/lib/ai/gemini.ts)
# rotates round-robin, retries 429/5xx once on the next key, and skips keys that
# return 401/402/403 (invalid key / depleted billing) without spending a retry.
# GEMINI_API_KEY (single key) still works as a fallback.
GEMINI_API_KEYS=key-from-project-a,key-from-project-b

# --- Cron (TP/SL + DCA runner) ---
CRON_SECRET=
